# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://manga_user:your_password@localhost:5434/manga_automation
DB_PASSWORD=your_secure_password_here

# ─── Media Hosting (Supabase Storage) ────────────────────────────────────────────
# Used by the dashboard "Publish" flow: local clips are uploaded here to get a
# public URL that AiToEarn (cloud) can fetch. Service role key is server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── AI Keys ───────────────────────────────────────────────────────────────────
# Primary LLM key. Use free-claude-code proxy by setting ANTHROPIC_BASE_URL below.
ANTHROPIC_API_KEY=sk-ant-...
# Anthropic-compatible base URL. Point to free-claude-code proxy for free models:
#   ANTHROPIC_BASE_URL=http://localhost:8082/v1
ANTHROPIC_BASE_URL=
OPEN_ROUTER=

# ─── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe_dashboard

# ─── Official AiToEarn API/MCP (Primary Ops Path) ─────────────────────────────
# Global environment defaults (your key must be from aitoearn.ai account)
AITOEARN_PRIMARY=false
AITOEARN_FALLBACK_LOCAL=true
AITOEARN_TRANSPORT=mcp
AITOEARN_BASE_URL=https://aitoearn.ai
AITOEARN_API_KEY=
AITOEARN_MCP_URL=https://aitoearn.ai/api/unified/mcp
AITOEARN_SSE_URL=https://aitoearn.ai/api/unified/sse
AITOEARN_HEALTH_PATH=/api/ops/health
AITOEARN_TIMEOUT_SEC=60
AITOEARN_RETRIES=2
AITOEARN_RETRY_BACKOFF_SEC=1.5
# Optional endpoint overrides when your AiToEarn account exposes custom routes:
# AITOEARN_STAGE_PATHS_JSON={"trend":"/api/ops/trend","create":"/api/ops/create","publish":"/api/ops/publish","engage":"/api/ops/engage","monetize":"/api/ops/monetize"}
# AITOEARN_ACTION_PATHS_JSON={"pipeline":"/api/ops/pipeline","status":"/api/ops/status"}
# MCP mode uses tool names instead of REST paths:
# AITOEARN_STAGE_MCP_TOOL_MAP_JSON={"trend":"listTaskMarket","create":"getDraftGenerationPricing","engage":"listInteractionRecords","monetize":"getMyBalance"}
# AITOEARN_ACTION_MCP_TOOL_MAP_JSON={"status":"getMyProfile"}
# Optional publish fanout behavior:
# AITOEARN_DEFAULT_VIDEO_URL=https://example.com/video.mp4
# AITOEARN_PUBLISH_STATUS_POLL_ATTEMPTS=4
# AITOEARN_PUBLISH_STATUS_POLL_SEC=3
# If true, publish calls without flowId are treated as failed (stricter tracking).
# AITOEARN_UNVERIFIED_AS_FAILURE=0

# ─── Voiceover (ElevenLabs + Kokoro local fallback) ───────────────────────────
VOICE_PROVIDER=elevenlabs
VOICE_ENABLE_FALLBACK=true
VOICEOVER_DIR=/data/voiceovers

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# Kokoro local runner (node + kokoro-js)
KOKORO_RUNNER_PATH=/app/scripts/kokoro_tts_runner.mjs
KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_sky
KOKORO_DTYPE=q8

# ─── TikTok (Playwright automation) ────────────────────────────────────────────
TIKTOK_EMAIL=your_email@example.com
TIKTOK_PASSWORD=your_password

# ─── Meta Graph (Instagram / Facebook Page / Threads) ───────────────────────────
# Long-lived user or page token with the right scopes; used as fallback for all three.
META_API_KEY=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_USER_ID=your_instagram_user_id
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_GRAPH_BASE=https://graph.threads.net/v1.0
THREADS_PUBLISH_DELAY_SEC=3

# ─── Hermes autonomous discovery (/aito_hermes without URL) ───────────────────
# HERMES_DISCOVER_MAX_CANDIDATES=12
# HERMES_DISCOVER_MIN_SCORE=0.65
# TELEGRAM_HERMES_TIMEOUT_SEC=600
# HERMES_REGISTER_CHROMA=0
# DEDUP_USE_CHROMA=0

# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# ─── External APIs (all free) ──────────────────────────────────────────────────
MAL_CLIENT_ID=your_mal_client_id
# AniList - no key required (public GraphQL API)
# MangaDex - no key required for public endpoints

# ─── Postiz (self-hosted recommended) ──────────────────────────────────────────
# For local Postiz, run Postiz separately and point this base URL to its backend:
# Example: http://localhost:3000/public/v1
POSTIZ_PUBLIC_API_BASE=http://localhost:3000/public/v1
POSTIZ_API_KEY=
# Optional hard-map when provider matching is ambiguous
POSTIZ_INTEGRATION_IDS_JSON={"tiktok":"...","youtube":"...","instagram":"...","pinterest":"...","x":"..."}
POSTIZ_PINTEREST_BOARD=
POSTIZ_AUTOPUBLISH_SLUGS=tiktok,youtube_shorts,instagram_reels,pinterest_video,x_twitter_threads

# ─── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=your_n8n_password
N8N_HOST=localhost

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ─── Trend-Driven Planner (cross-domain, not anime-only) ──────────────────────
TREND_PLANNER_LIMIT=10
TREND_REPURPOSE_RATIO=0.5
TREND_MIN_CONFIDENCE=0.3

# ─── Telegram Bot Control ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Comma-separated numeric chat IDs allowed to control the bot (recommended)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_INTERVAL=2

# ─── last30days Research Ingest ────────────────────────────────────────────────
# Installed command template. "{query}" is replaced at runtime.
LAST30DAYS_COMMAND_TEMPLATE=last30days "{query}"
# Separate multiple queries with new lines or ||
LAST30DAYS_DEFAULT_QUERIES=
LAST30DAYS_REGION=US
LAST30DAYS_SCHEDULE_SECONDS=21600

# ─── Agent scheduler (docker compose --profile schedulers up agent-scheduler) ─
# JSON array of jobs: name, interval_seconds, path, body, optional method/timeout
# Example: [{"name":"crew-4h","interval_seconds":14400,"path":"/api/summon-agent","body":{"prompt":"Find trending shorts","target_count":5}}]
AGENT_SCHEDULE_JOBS=[]
AGENT_SCHEDULER_TICK_SECONDS=60
AGENT_SCHEDULER_WORKER_URL=http://python-worker:8080

# ─── DeerFlow Hybrid Layer ─────────────────────────────────────────────────────
DEERFLOW_URL=http://localhost:2026
DEERFLOW_GATEWAY_URL=http://localhost:2026/api
DEERFLOW_LANGGRAPH_URL=http://localhost:2026/api/langgraph
DEERFLOW_MODEL_NAME=
# crewai | deerflow
SUMMON_BACKEND=crewai

# ─── Paths (inside containers) ─────────────────────────────────────────────────
PANELS_DIR=/data/panels
VIDEOS_DIR=/data/videos
LOGS_DIR=/data/logs

# ─── Automation settings ───────────────────────────────────────────────────────
MAX_UPLOADS_PER_ACCOUNT_DAY=3
DUPLICATE_MAX_USES=5
VIDEO_MIN_DURATION_SECONDS=60
SHADOW_BAN_FYP_THRESHOLD=0.10
ARBITRAGE_AITOEARN_PRIMARY=0

GOOGLE_CLIENT_ID=923431671500-flqbnpe08rehgl8o2d78ii1s6j3mcl59.apps.googleusercontent.com 
GOOGLE_CLIENT_SECRET=...

# ─── Engagement Automation ─────────────────────────────────────────────────────
ENGAGE_HEADLESS=1
ENGAGE_MAX_LIKES=30
ENGAGE_MAX_FOLLOWS=15
ENGAGE_FOLLOW_COOLDOWN_HOURS=24
ENGAGE_PROXY_URL=
ENGAGE_AI_MODEL=claude-sonnet-4-6

# ─── Marketplace Monetization ───────────────────────────────────────────────────
MARKETPLACE_DEFAULT_COMMISSION=0.10

# ─── X/Twitter Trends ───────────────────────────────────────────────────────────
X_BEARER_TOKEN=

# ─── Reddit Trends ──────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_TREND_LIMIT=20

# ─── Finance / Referral System ────────────────────────────────────────────────
REFERRAL_HUB_URL=https://your-domain.com/links
EARNINGS_SCREENSHOTS_DIR=/data/earnings_screenshots
FINANCE_VIDEOS_DIR=/data/finance_videos

# ─── AI Video Generation (choose one provider) ────────────────────────────────
# Default provider: revid | creatify | heygen | invideo
FINANCE_VIDEO_PROVIDER=revid

# ⭐ Revid.ai (BEST — brainrot style: Subway Surfers background + AI voice + captions)
# Exactly like @mini.money.matters Instagram reels
# Sign up: https://revid.ai (Growth plan ~$49/mo)
# Get API key: revid.ai/account
# Get voice/background IDs: revid.ai/create → pick style → "..." → "Get API Code"
REVID_API_KEY=
REVID_VOICE_ID=              # leave blank to use Revid's default voice
REVID_BACKGROUND=subway_surfers   # subway_surfers | minecraft | temple_run | gta | satisfying

# Creatify (ad-style proof videos — professional look)
# Sign up: https://creatify.ai → Account Settings → API
# Plans: from $49/mo for API access
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_AVATAR_ID=         # run /list_avatars creatify to get IDs
CREATIFY_VOICE_ID=          # optional: leave blank for default voice

# HeyGen (talking-head avatar — no face camera needed)
# Sign up: https://heygen.com → API → Pay-as-you-go ($1/min)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=           # run /list_avatars heygen to get IDs
HEYGEN_VOICE_ID=            # optional: leave blank for English default

# InVideo (stock footage explainer videos)
# Sign up: https://invideo.io → Developer Portal
INVIDEO_API_KEY=

