# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://manga_user:your_password@localhost:5434/manga_automation
DB_PASSWORD=your_secure_password_here

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── AI Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── TikTok (Playwright automation) ────────────────────────────────────────────
TIKTOK_EMAIL=your_email@example.com
TIKTOK_PASSWORD=your_password

# ─── Instagram Graph API ────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_USER_ID=your_instagram_user_id

# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# ─── External APIs (all free) ──────────────────────────────────────────────────
MAL_CLIENT_ID=your_mal_client_id
# AniList - no key required (public GraphQL API)
# MangaDex - no key required for public endpoints

# ─── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=your_n8n_password
N8N_HOST=localhost

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ─── Paths (inside containers) ─────────────────────────────────────────────────
PANELS_DIR=/data/panels
VIDEOS_DIR=/data/videos
LOGS_DIR=/data/logs

# ─── Automation settings ───────────────────────────────────────────────────────
MAX_UPLOADS_PER_ACCOUNT_DAY=3
DUPLICATE_MAX_USES=5
VIDEO_MIN_DURATION_SECONDS=60
SHADOW_BAN_FYP_THRESHOLD=0.10
