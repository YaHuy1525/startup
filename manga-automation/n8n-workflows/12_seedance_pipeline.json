{
  "name": "12 Seedance AI Video Pipeline",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:8080/aitoearn/seedance/workflow",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.prompt || 'Cinematic product shot, 9:16 vertical, premium lighting' }}\",\n  \"model\": \"seedance-2-beta-1080p\",\n  \"ratio\": \"9:16\",\n  \"duration\": 12,\n  \"publish\": {{ $json.publish || false }},\n  \"title\": \"{{ $json.title || 'AI clip' }}\",\n  \"channels\": {{ $json.channels || [\"tiktok\"] }}\n}"
      },
      "id": "seedance-workflow",
      "name": "Seedance Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [420, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Seedance Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
