        "url": "http://manga-agents:3001/agents/detect-trends",
        "options": {
          "timeout": 60000
        }
      },
      "id": "detect-trends-backend",
      "name": "Backend: Detect Trending Manga",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Extract manga IDs from detect-trends response\nconst result = $input.item.json.result || '';\n\n// The result is a text response from the agent\n// We need to query the database to get the manga IDs that were just upserted\n// For now, we'll trigger a fetch for all active manga\nreturn [{ json: { success: true, message: 'Trends detected and saved' } }];"
      },
      "id": "extract-manga-ids",
      "name": "Code: Extract Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title FROM manga WHERE is_active = true ORDER BY trending_score DESC"
      },
      "id": "get-active-manga",
      "name": "DB: Get Active Manga",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        900,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "2",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://manga-agents:3001/pipeline/populate-queue",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "manga_id",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "populate-queue",
