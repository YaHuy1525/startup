    {
      "parameters": {
        "method": "GET",
        "url": "https://api.myanimelist.net/v2/manga/ranking?ranking_type=manga&limit=20&fields=id,title,mean,rank,popularity,status,genres",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-MAL-CLIENT-ID",
              "value": "02d721ff8b92ebf2f9b2760d2a672c68"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "mal-get-trending",
      "name": "MAL: Get Trending Manga",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Transform MAL API response into DB-ready rows\nconst items = $input.item.json.data || [];\n\nfunction mapStatus(s) {\n  const map = {\n    currently_publishing: 'ongoing',\n    finished: 'completed',\n    on_hiatus: 'hiatus',\n    discontinued: 'completed',\n    not_yet_published: 'ongoing'\n  };\n  return map[s] || 'ongoing';\n}\n\nfunction calcScore(mean, rank, popularity) {\n  const ratingScore  = ((mean - 7.0) / 2.5) * 60;\n  const rankScore    = Math.max(0, 25 - rank / 4);\n  const popScore     = Math.max(0, 15 - popularity / 20);\n  return parseFloat(Math.min(100, Math.max(0, ratingScore + rankScore + popScore)).toFixed(2));\n}\n\nfunction esc(s) { return String(s).replace(/'/g, \"''\"); }\n\nreturn items.map(item => {\n  const mal_id         = item.node.id;\n  const title          = esc(item.node.title);\n  const genre          = esc((item.node.genres || []).map(g => g.name).join('/'));\n  const tags           = (item.node.genres || []).map(g => g.name.toLowerCase());\n  const status         = mapStatus(item.node.status);\n  const trending_score = calcScore(\n    item.node.mean       || 7.0,\n    item.ranking?.rank   || 999,\n    item.node.popularity || 500\n  );\n  const tagsSql = tags.map(t => `'${esc(t)}'`).join(',') || \"''\";\n\n  const sql = `INSERT INTO manga (title, mal_id, genre, tags, status, trending_score, is_active, updated_at) VALUES ('${title}', ${mal_id}, '${genre}', ARRAY[${tagsSql}]::text[], '${status}', ${trending_score}, true, NOW()) ON CONFLICT (title) DO UPDATE SET mal_id = EXCLUDED.mal_id, genre = EXCLUDED.genre, tags = EXCLUDED.tags, status = EXCLUDED.status, trending_score = EXCLUDED.trending_score, is_active = true, updated_at = NOW()`;\n\n  return { json: { mal_id, title, genre, tags, status, trending_score, sql } };\n});"
      },
      "id": "transform-mal-data",
      "name": "Code: Transform MAL Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}"
