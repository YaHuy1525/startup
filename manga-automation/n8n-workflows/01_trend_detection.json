      "id": "fetch-chapters-backend",
      "name": "Backend: Fetch Latest Chapters",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "jsCode": "// Extract only newly fetched chapters (not already_processed or error)\nconst results = $input.item.json.results || [];\n\nconst newChapters = results.filter(r => r.status === 'fetched' && r.chapterId);\n\nif (newChapters.length === 0) {\n  // Return a sentinel so the IF node can detect 'nothing new'\n  return [{ json: { hasNew: false, chapterId: null } }];\n}\n\nreturn newChapters.map(r => ({\n  json: {\n    hasNew: true,\n    chapterId: r.chapterId,\n    title: r.title,\n    panels: r.panels\n  }\n}));"
      },
      "id": "filter-new-chapters",
      "name": "Code: Filter New Chapters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
