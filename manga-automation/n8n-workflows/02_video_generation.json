{
  "name": "Manga Automation - Video Generation (Remotion)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "cron-video-check",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sp.id AS selection_id, sp.chapter_id, sp.panels, mc.panel_urls, m.title FROM selected_panels sp JOIN manga_chapters mc ON sp.chapter_id = mc.id JOIN manga m ON mc.manga_id = m.id LEFT JOIN videos v ON sp.chapter_id = v.chapter_id WHERE v.id IS NULL ORDER BY sp.selected_at ASC LIMIT 5"
      },
      "id": "fetch-panel-queue",
      "name": "DB: Fetch Ready Panels",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "aJSEMdFYhwBqNlYS",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-id",
              "leftValue": "={{ $json.selection_id }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-items",
      "name": "Has Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://manga-agents:3001/pipeline/render-video",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chapterId",
              "value": "={{ $json.chapter_id }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "render-video-remotion",
      "name": "Remotion: Render Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-render-success",
      "name": "Render Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://manga-agents:3001/agents/generate-caption",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "videoId",
              "value": "={{ $json.videoId }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "call-caption-generator",
      "name": "Agent: Generate Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1250,
        150
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/trigger-publisher",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_id",
              "value": "={{ $node[\"Remotion: Render Video\"].json.videoId }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "trigger-publisher",
      "name": "Webhook: Trigger Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1450,
        150
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "DB: Fetch Ready Panels",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DB: Fetch Ready Panels": {
      "main": [
        [
          {
            "node": "Has Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Items?": {
      "main": [
        [
          {
            "node": "Remotion: Render Video",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Remotion: Render Video": {
      "main": [
        [
          {
            "node": "Render Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Succeeded?": {
      "main": [
        [
          {
            "node": "Agent: Generate Caption",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Agent: Generate Caption": {
      "main": [
        [
          {
            "node": "Webhook: Trigger Publisher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
