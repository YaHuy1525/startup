# ─── short-video-maker (Docker) ────────────────────────────────────────────────
# Free Pexels API key (required): https://www.pexels.com/api/
PEXELS_API_KEY=
# pino log level: trace | debug | info | warn | error | fatal | silent
SVM_LOG_LEVEL=debug
# forward whisper.cpp output to stdout
SVM_WHISPER_VERBOSE=false

# ─── Render server ─────────────────────────────────────────────────────────────
# Port for the Express render server (server/index.ts)
PORT=3333
# Default composition id rendered by POST /render
SHORT_COMP_ID=ShortVideo
